# Copy to .env.local and fill in before running the dev server.
# See the README for details.

# SendGrid — all three are required for /api/enquiry to send mail.
SENDGRID_API_KEY=your_sendgrid_api_key
ENQUIRY_TO_EMAIL=info@sherriffindustrysolutions.com
# Must be a verified sender in SendGrid.
ENQUIRY_FROM_EMAIL=enquiries@sherriffindustrysolutions.com

# Optional: production URL used for the canonical link and structured data.
# NEXT_PUBLIC_SITE_URL=https://example.com.au
